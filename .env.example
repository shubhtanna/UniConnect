# Use "mongodb" in production. "memory" is only for local UI development and
# resets all users and OTPs when the development server restarts.
DATABASE_MODE=mongodb

# MongoDB database used by the application when DATABASE_MODE=mongodb
MONGODB_URI=mongodb://127.0.0.1:27017/uniconnect
MONGODB_DB=uniconnect

# At least 32 random characters. Use a unique value in every environment.
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Used as an additional secret when hashing one-time passwords.
OTP_PEPPER=replace-with-another-long-random-secret-at-least-32-characters

# Optional temporary access for a private tester. This only opens the existing
# shubh.tanna_pgpaias27@mastersunion.org account. Keep disabled unless needed,
# use a random 32+ character secret, and always provide an expiry timestamp.
TEST_ACCESS_ENABLED=false
TEST_ACCESS_SECRET=
TEST_ACCESS_EXPIRES_AT=

# SMTP is required in production. In development, an unset SMTP host writes the
# OTP to the server console instead of attempting delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=UniConnect <no-reply@mastersunion.org>

# Use "local" for development. Production must use "cloudinary".
STORAGE_MODE=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional in development. Without this, UniConnect uses deterministic local
# extraction and embeddings so the complete profile flow remains testable.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# MongoDB Atlas Vector Search index over profiles.resumeEmbedding
ATLAS_VECTOR_INDEX=profile_embedding
